# WanderInk / shanhai 环境变量模板
# 用法:cp .env.example .env,然后按下面三段填。值一律是占位符,勿直接使用。
# 完整部署步骤见 docs/deploy-from-github.md。
#
# 变量名规则:Settings 类(src/shanhai/config.py)带 env_prefix="SHANHAI_",
# 所以字段 base_url 对应 SHANHAI_BASE_URL。本文件列的是全集,注释里标了默认值。
# ⚠️ systemd 部署时进程环境优先于 .env(load_dotenv(override=False)),
#    unit 里要用 EnvironmentFile= 指到这个文件,别指望 .env 被自动读到。

# ========== 1. 必填(缺了进程起不来)==========
# 这两个是 pydantic 的必填字段,没有默认值:缺失时 Settings() 校验失败,服务直接崩。
# 任何 OpenAI 兼容的服务都能接;下面各环节可单独覆盖,不覆盖就回落到这一对。
SHANHAI_BASE_URL=https://your-provider.example.com/v1
SHANHAI_API_KEY=sk-replace-me

# ========== 2. 生产必设(不设也能跑,但会出问题)==========
# 登录态是 Starlette 签名 cookie 的密钥。不设则每次启动生成随机值 =>
# **一重启所有人被登出**,并在 stderr 打警告。生成:python3 -c "import secrets;print(secrets.token_hex(32))"
SHANHAI_SESSION_SECRET=

# 监听地址与端口(默认 127.0.0.1:8080)。要让同网段/内网访问必须设 0.0.0.0。
SHANHAI_HOST=127.0.0.1
SHANHAI_PORT=8080

# ========== 3. 可选 ==========
# ---- 服务行为 ----
# 只读模式:关闭新建生成、隐藏编辑入口(公网展示用)。真值:1/true/yes/on。默认关。
SHANHAI_READONLY=
# 跨域来源,逗号分隔。默认 * (便于本地开发);前后端同源部署时可不管。
SHANHAI_CORS_ORIGINS=*
# cookie 加 Secure 标记。⚠️ 只有走 HTTPS 才能开;
# HTTP 内网直连时开了会让 cookie 完全发不出去,表现为"登录成功但立刻又要求登录"。默认关。
SHANHAI_SESSION_HTTPS_ONLY=
# 运行时覆盖配置的文件路径(Web 配置面板写的就是它)。默认 config.json。
SHANHAI_CONFIG_PATH=config.json

# ---- 分环节端点覆盖:不设则回落到上面的 SHANHAI_BASE_URL / SHANHAI_API_KEY ----
# 四类上游各自独立,可以混搭(如 LLM 走本地 Ollama、图像走云端)。
# 注意本文件只是**最底下那一层**。运行时还有三层叠在上面(存 config.json,Web 配置面板写的就是它):
#     .env(本文件) → config.json.global → config.json.users[作品归属者] → config.json.stages[环节]
# 后者压前者。users 层由每个用户自己配、只能配 LLM(见 runtime_config.UserOverride 的说明);
# global 与 stages 仍限管理员。
# ⚠️ 用本机 shim 时这几个必须写 127.0.0.1,**不要填 shim 网关(:8099)的局域网地址**:
#    providers/_http.py 的本地单并发锁与 runtime_config.py 的出图并发档位都按 hostname
#    判定,换成非 loopback 会静默失效/变 2 路并发抢同一张卡。见 docs/deploy-gateway.md §0。
SHANHAI_LLM_BASE_URL=
SHANHAI_LLM_API_KEY=
SHANHAI_IMAGE_BASE_URL=
SHANHAI_IMAGE_API_KEY=
SHANHAI_TTS_BASE_URL=
SHANHAI_TTS_API_KEY=
SHANHAI_MUSIC_BASE_URL=
SHANHAI_MUSIC_API_KEY=

# ---- 文本(S0-S2:传说检索 / 剧本 / 分镜)----
SHANHAI_LLM_MODEL=claude-sonnet-5
# openai = 标准 /chat/completions;ollama = Ollama 原生 API(think:false + schema,实测快 10×)
SHANHAI_LLM_PROVIDER=openai
# 秒,默认 300。本地思考型模型(如 qwen3 122b)建议调大。
SHANHAI_LLM_TIMEOUT=300

# ---- 图像(S3 角色三视图 / S4 漫画页)----
SHANHAI_IMAGE_MODEL=gemini-2.5-flash-image
# images_api = /images/generations|edits 形态;chat_api = 多模态 chat 返图形态。按你的上游选。
SHANHAI_IMAGE_API_MODE=chat_api
SHANHAI_IMAGE_SIZE=1536x1024
# 秒,默认 300。**只是单次 HTTP 超时**,单页含重试的总预算另算(见 s4_pages.PAGE_BUDGET_FACTOR)。
# 上游排队严重(如本地 ComfyUI 队列长)时调大,否则会 504 导致整页生成失败。
SHANHAI_IMAGE_TIMEOUT=300
# 仅本地 ComfyUI 有意义,值是 src/shanhai/loras.py 里 LORA_PRESETS 的短 key。
SHANHAI_IMAGE_LORA_MODEL=

# ---- 配音与配乐(S5)----
SHANHAI_TTS_MODEL=gpt-4o-mini-tts
SHANHAI_TTS_VOICE=alloy
# 逗号分隔的可选音色,会出现在新建作品表单的下拉里;空则只有上面那一个。
SHANHAI_TTS_VOICES=
# 英文轨默认音色(须是 TTS 后端认得的 key);空则沿用 SHANHAI_TTS_VOICE。
SHANHAI_TTS_VOICE_EN=
SHANHAI_MUSIC_MODEL=ace-step-v1.5xl

# ---- 合成(S6)----
# 单条 ffmpeg 命令的墙钟上限,秒,默认 1800。**不是**整个 S6 的预算,是每一次调用各自的。
# 存在的意义只是"别永远挂着":卡死的 ffmpeg 会永久占住一个后台作业槽(共 4 个),
# 上传录音那条路更是直接卡住一个 HTTP 请求线程。实测最贵的一次调用是整片 xfade 重编码
# (本机 10 页成片 31s),1800 已是很大的余量;正常渲染永远碰不到它。
SHANHAI_FFMPEG_TIMEOUT=1800
# ffprobe 读时长的上限,秒,默认 60。实测 0.02s,给 60 纯粹是防呆。
SHANHAI_FFPROBE_TIMEOUT=60

# ---- 一致性 ----
# True 时 S4 遇到没有三视图的角色直接失败;默认 false = 告警但继续(退化成纯文字特征)。
SHANHAI_STRICT_CONSISTENCY=false
