        IN["<b>输入</b><br/><span style='font-size:10px'>景区名称</span>"]
        S0["<b>S0 传说检索</b><br/><span style='font-size:10px;color:#6b7280'>来源标注</span>"]
        S1["<b>S1 剧本改编</b><br/><span style='font-size:10px;color:#6b7280'>编剧大师 skill</span>"]
        S2["<b>S2 分镜设计</b><br/><span style='font-size:10px;color:#6b7280'>导演大师 skill</span>"]
        S3["<b>S3 角色三视图</b><br/><span style='font-size:10px;color:#6b7280'>导演大师 skill</span>"]
        S4["<b>S4 逐页生图</b><br/><span style='font-size:10px;color:#6b7280'>三视图参考</span>"]
        S5["<b>S5 配音配乐</b><br/><span style='font-size:10px;color:#6b7280'>TTS + BGM</span>"]
        S6["<b>S6 合成输出</b><br/><span style='font-size:10px;color:#6b7280'>FFmpeg</span>"]
        IN --> S0 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6
    end

    subgraph PROJ["<b>Project 聚合根</b><br/><span style='font-size:10px;color:#6b7280'>project.json · 原子写 · 断点续跑</span>"]
        direction TB
        DATA["<span style='font-size:11px'>legend · script · storyboard<br/>characters · cells · bgm · output</span>"]
    end

    subgraph PROV["<b>Provider 层</b><br/><span style='font-size:10px;color:#6b7280'>OpenAI 兼容 · 可插拔</span>"]
        direction TB
        LLM["<b>LLMClient</b>"]
        IMG["<b>ImageClient</b>"]
        TTS["<b>TTSClient</b>"]
        MUS["<b>MusicClient</b>"]
        GUARD["<b>local_backend_guard</b><br/><span style='font-size:10px;color:#6b7280'>本地端点全局单并发</span>"]
        LLM --> GUARD
        IMG --> GUARD
        TTS --> GUARD
        MUS --> GUARD
    end

    subgraph SRV["<b>模型服务层</b><br/><span style='font-size:10px;color:#6b7280'>DGX Spark · 119GB 统一内存 · 分时加载</span>"]
        direction LR
        HERMES["<b>Hermes :8642</b><br/><span style='font-size:10px;color:#6b7280'>编剧 / 导演 skill<br/>底层模型 glm5.2</span>"]
        COMFY["<b>ComfyUI :8188</b><br/><span style='font-size:10px;color:#6b7280'>Qwen-Image-Edit-2511</span>"]
        COSY["<b>CosyVoice2 :8090</b><br/><span style='font-size:10px;color:#6b7280'>0.5B · PyTorch nightly cu128</span>"]
        ACE["<b>ACE-STEP 1.5 XL :8092</b><br/><span style='font-size:10px;color:#6b7280'>纯器乐 BGM</span>"]
        TUZI["<b>tu-zi API</b><br/><span style='font-size:10px;color:#6b7280'>gpt-image-2 图像</span>"]
        HERMES --- COMFY
        COSY --- ACE --- TUZI
    end

    subgraph OUT["<b>输出层</b><br/><span style='font-size:10px;color:#6b7280'>Output Layer</span>"]
        direction TB
        FF["<b>FFmpeg + PIL</b><br/><span style='font-size:10px;color:#6b7280'>Ken Burns · 字幕分层 · 水印<br/>xfade · loudnorm · BGM 混音</span>"]
        MP4["<b>final.mp4</b><br/><span style='font-size:10px;color:#6b7280'>1080p · h264+aac<br/>AI 水印 · 来源标注</span>"]
        FF --> MP4
    end

    %% 编排 → Project
    S0 -.->|"读写"| DATA
    S6 -.->|"读写"| DATA

    %% 编排 → Provider
    S0 -->|"文本"| LLM
    S1 -->|"文本"| LLM
    S2 -->|"文本"| LLM
    S3 -->|"文本"| LLM
    S3 -->|"图像"| IMG
    S4 -->|"图像"| IMG
    S5 -->|"配音"| TTS
    S5 -->|"配乐"| MUS

    %% Provider → 模型服务
    LLM -->|"S0–S3"| HERMES
    IMG --> TUZI
    TTS --> COSY
    MUS --> ACE

    %% 合成
    S6 --> FF

